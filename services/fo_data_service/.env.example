# Unified database configuration (targets Artha PostgreSQL/TimescaleDB)
DATABASE_URL=postgresql://artha:artha_dev@localhost:5432/artha

# Angel One SmartAPI Credentials (paste fresh credentials here)
ANGELONE_CLIENT_ID=
ANGELONE_PIN=
ANGELONE_API_KEY=
ANGELONE_TOTP_SECRET=

# Scheduler & Timezone Settings
TIMEZONE=Asia/Kolkata
MARKET_START_TIME=09:15
MARKET_END_TIME=15:30
